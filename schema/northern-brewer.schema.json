{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northern-brewer.schema.json",
  "title": "Northern Brewer Belgian candi sugar",
  "description": "Belgian candi sugars/syrups from Northern Brewer (CSI products excluded).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "slug", "maltster", "product_type"],
  "properties": {
    "name":         { "type": "string", "minLength": 1 },
    "slug":         { "type": "string", "minLength": 1 },
    "maltster":     { "type": "string", "enum": ["Northern Brewer", "L.D. Carlson"] },
    "product_type": { "type": "string", "enum": ["sugar", "syrup"] },
    "description":  { "type": "string" },
    "extract_pct":  { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "color_unit":   { "type": ["string", "null"], "enum": ["lovibond", "srm", "ebc", null] },
    "color_min":    { "type": ["number", "null"], "minimum": 0 },
    "color_max":    { "type": ["number", "null"], "minimum": 0 }
  }
}
