{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brewtarget.schema.json",
  "title": "Brewtarget sugar",
  "description": "Sugar ingredients extracted from Brewtarget's GPL ingredient database.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "slug", "maltster", "product_type"],
  "properties": {
    "name":         { "type": "string", "minLength": 1 },
    "slug":         { "type": "string", "minLength": 1 },
    "maltster":     { "type": "string", "const": "Brewtarget" },
    "product_type": { "type": "string", "enum": ["sugar", "syrup"] },
    "extract_pct":  { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "moisture_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "color_unit":   { "type": ["string", "null"], "enum": ["srm", "lovibond", "ebc", null] },
    "color_min":    { "type": ["number", "null"], "minimum": 0 },
    "color_max":    { "type": ["number", "null"], "minimum": 0 }
  }
}
