{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bairds.schema.json",
  "title": "Bairds intermediate malt",
  "description": "Raw, maltster-native fields extracted from a Bairds malt page.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "slug", "maltster"],
  "properties": {
    "name":          { "type": "string", "minLength": 1 },
    "slug":          { "type": "string", "minLength": 1 },
    "maltster":      { "type": "string", "const": "Bairds" },
    "description":   { "type": "string" },
    "notes":         { "type": "string" },
    "extract_pct":   { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "color_srm_min": { "type": ["number", "null"], "minimum": 0 },
    "color_srm_max": { "type": ["number", "null"], "minimum": 0 }
  }
}
