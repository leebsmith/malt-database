{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dingemans.schema.json",
  "title": "Dingemans intermediate malt",
  "description": "Raw, maltster-native fields extracted from a Dingemans malt page.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "slug", "maltster"],
  "properties": {
    "name":        { "type": "string", "minLength": 1 },
    "slug":        { "type": "string", "minLength": 1 },
    "maltster":    { "type": "string", "const": "Dingemans" },
    "category_hint": { "type": "string" },
    "description": { "type": "string" },
    "notes":       { "type": "string" },
    "extract_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "moisture_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "color_unit":  { "type": ["string", "null"], "enum": ["lovibond", "srm", "ebc", null] },
    "color_value": { "type": ["number", "null"], "minimum": 0 }
  }
}
