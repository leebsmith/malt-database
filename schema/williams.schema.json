{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "williams.schema.json",
  "title": "Williams Brewing candi syrup",
  "description": "Candi syrup data extracted from Williams Brewing product pages.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "slug", "maltster", "product_type"],
  "properties": {
    "name":         { "type": "string", "minLength": 1 },
    "slug":         { "type": "string", "minLength": 1 },
    "maltster":     { "type": "string", "const": "Williams Brewing" },
    "product_type": { "type": "string", "const": "syrup" },
    "description":  { "type": "string" },
    "extract_pct":  { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "color_unit":   { "type": ["string", "null"], "enum": ["ebc", "srm", "lovibond", null] },
    "color_min":    { "type": ["number", "null"], "minimum": 0 },
    "color_max":    { "type": ["number", "null"], "minimum": 0 }
  }
}
